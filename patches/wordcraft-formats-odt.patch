+// ODF table-header-rows means repetition, not first-row styling. Keep the shared
+// flow conversion unchanged for HTML/Markdown; disable its styling heuristic only
+// on this shallow-cloned ODT export view, including nested tables in page parts.
+fn odt_flow(doc: &Document, blocks: &wordcraft_doc::Blocks) -> model::Flow {
+    fn explicit_headers(blocks: &mut wordcraft_doc::Blocks, depth: usize) {
+        if depth > wordcraft_doc::table::MAX_TABLE_DEPTH { return; }
+        for block in blocks {
+            if !matches!(&**block, wordcraft_doc::Block::Table(_)) { continue; }
+            if let wordcraft_doc::Block::Table(table) = std::sync::Arc::make_mut(block) {
+                table.props.look.header_row = false;
+                for row in &mut table.rows { for cell in &mut row.cells { explicit_headers(&mut cell.blocks, depth + 1); } }
+            }
+        }
+    }
+    let mut export = doc.clone(); export.body = blocks.clone();
+    explicit_headers(&mut export.body, 0);
+    model::from_doc_tracked(&export)
+}
